# Default LLM — sign up at https://platform.openai.com
OPENAI_API_KEY=your_openai_key_here

# Alternative: Claude — sign up at https://console.anthropic.com
# Only needed if you set LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=your_anthropic_key_here
# LLM_BACKEND=anthropic

# Search backend: "serper" (recommended), "ddgs" (default, free), "brave", or "google"
# Serper.dev: sign up at https://serper.dev — 2,500 free searches on signup
SEARCH_BACKEND=serper
SERPER_API_KEY=your_serper_api_key_here

# Brave Search (alternative)
# SEARCH_BACKEND=brave
# BRAVE_API_KEY=your_brave_api_key_here

# Google Custom Search (alternative)
# SEARCH_BACKEND=google
# GOOGLE_API_KEY=your_google_key_here
# GOOGLE_CSE_ID=your_cse_id_here
