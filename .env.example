# FREE option — sign up at https://console.groq.com (no credit card needed)
GROQ_API_KEY=your_groq_key_here

# PAID option — sign up at https://console.anthropic.com
# Only needed if you set LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=your_anthropic_key_here
# LLM_BACKEND=anthropic

# Search backend: "brave" (recommended), "ddgs" (default, free), or "google"
# Brave: sign up at https://api.search.brave.com — 2,000 free queries/month
SEARCH_BACKEND=brave
BRAVE_API_KEY=your_brave_api_key_here

# Google Custom Search (alternative)
# SEARCH_BACKEND=google
# GOOGLE_API_KEY=your_google_key_here
# GOOGLE_CSE_ID=your_cse_id_here
